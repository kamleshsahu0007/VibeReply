# OpenAI / Gemini API
OPENAI_API_KEY=AQ....
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=models/gemini-3.6-flash
OPENAI_TIMEOUT_MS=20000
# Keep at 0: OPENAI_MODEL_FALLBACKS below already retries a failed request
# on a DIFFERENT model immediately. The SDK's own same-model retry honors
# the provider's Retry-After on a 429, which for a per-minute quota window
# can be tens of seconds — a real request once spent 20s+ per retry attempt
# stuck on a rate-limited model before ever reaching the fallback chain.
OPENAI_MAX_RETRIES=0

# Optional: comma-separated models to try in order if OPENAI_MODEL's call
# fails (rate-limited, deprecated, temporarily down). All go through the
# same OPENAI_BASE_URL/OPENAI_API_KEY above. Empty = no fallback chain.
# List your key's actual available models with:
#   curl "$OPENAI_BASE_URL/models" -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_MODEL_FALLBACKS=models/gemini-3.7-flash,models/gemini-3.5-flash,models/gemini-3.1-flash-lite,models/gemini-2.5-flash,models/gemini-2.5-pro,models/gemini-2.5-flash-lite,models/gemini-flash-latest,models/gemini-pro-latest,models/gemini-flash-lite-latest,models/gemini-3-flash-preview,models/gemini-3.1-pro-preview,models/gemini-3.1-flash-lite-preview

# Rate limiting (per IP, sliding window). Applies to /api/generate-replies
# (the OpenAI/Gemini-calling endpoint).
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# Separate, more generous limit for the /api/tones CRUD endpoints (cheap DB
# ops, no model call) — its own bucket so tone-list polling never eats into
# the generate-replies budget above.
RATE_LIMIT_TONES_REQUESTS=60
RATE_LIMIT_TONES_WINDOW_MS=60000

# Database (Postgres — pooled URL for the app, direct URL for migrations)
# Get both from Vercel: Storage tab -> your Postgres store -> ".env.local" tab
POSTGRES_PRISMA_URL="postgres://user:password@host/db?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://user:password@host/db"

# Razorpay (PRO subscription checkout) — India-first; Stripe stopped
# onboarding new India-based businesses, so this is the primary provider
# for now. Adding a second provider for international customers later is a
# separate, additive integration — it doesn't require touching this one.
# 1. Create a free Razorpay account (razorpay.com/signup) — test mode keys
#    work instantly, full KYC is only required before accepting live payments.
# 2. Create a recurring Plan for the PRO subscription: Dashboard ->
#    Subscriptions -> Plans -> Create plan (monthly, set your price in INR),
#    then put its id (starts "plan_...") below.
# 3. Keys: Dashboard -> Settings -> API Keys -> Generate Test Key
#    (key id starts "rzp_test_...", plus a matching secret — test mode
#    first, switch to live keys once KYC is approved).
# 4. Webhook secret: Dashboard -> Settings -> Webhooks -> Add New Webhook
#    -> URL = <your deployed URL>/api/razorpay/webhook -> Active events:
#    subscription.activated, subscription.charged, subscription.cancelled,
#    subscription.completed, subscription.halted, subscription.paused ->
#    set your own secret string there (this is NOT auto-generated like
#    Stripe's — you choose it yourself and it must match here exactly).
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_PLAN_ID=plan_...
RAZORPAY_WEBHOOK_SECRET=...

# App
NODE_ENV=development
ALLOWED_ORIGIN=*
