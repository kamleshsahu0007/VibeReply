# OpenAI / Gemini API
OPENAI_API_KEY=AQ....
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=models/gemini-3.6-flash
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=2

# Optional: comma-separated models to try in order if OPENAI_MODEL's call
# fails (rate-limited, deprecated, temporarily down). All go through the
# same OPENAI_BASE_URL/OPENAI_API_KEY above. Empty = no fallback chain.
# List your key's actual available models with:
#   curl "$OPENAI_BASE_URL/models" -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_MODEL_FALLBACKS=models/gemini-3.7-flash,models/gemini-3.5-flash,models/gemini-3.1-flash-lite,models/gemini-2.5-flash,models/gemini-2.5-pro,models/gemini-2.5-flash-lite,models/gemini-flash-latest,models/gemini-pro-latest,models/gemini-flash-lite-latest,models/gemini-3-flash-preview,models/gemini-3.1-pro-preview,models/gemini-3.1-flash-lite-preview

# Rate limiting (per IP, sliding window)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# Database (Postgres — pooled URL for the app, direct URL for migrations)
# Get both from Vercel: Storage tab -> your Postgres store -> ".env.local" tab
POSTGRES_PRISMA_URL="postgres://user:password@host/db?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://user:password@host/db"

# App
NODE_ENV=development
ALLOWED_ORIGIN=*
